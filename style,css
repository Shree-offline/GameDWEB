body {
    background-color: #1a1a2e; 
    color: #e0e0e0; 
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center; 
    justify-content: center; 
    height: 100vh; 
    margin: 0;
}

.game-box {
    background-color: #16213e;
    padding: 40px;
    border-radius: 15px; 
    box-shadow: 0 0 20px rgba(169, 129, 255, 0.3); 
    text-align: center;
}

h2 {
    color: #a981ff; 
    margin-top: 0;
    font-size: 28px;
}

input {
    padding: 10px;
    font-size: 18px;
    border: 2px solid #a981ff;
    border-radius: 5px;
    background-color: #0f3460;
    color: white;
    outline: none;
    text-align: center;
    width: 80px;
}

button {
    padding: 12px 20px;
    font-size: 16px;
    background-color: #e94560; 
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.2s; 
}

button:hover {
    background-color: #ff2e63;
}

#feedback {
    margin-top: 20px;
    font-size: 20px;
    font-weight: bold;
    min-height: 25px; 
}
